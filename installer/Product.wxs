<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="DirSize for Explorer"
           Manufacturer="DirSize Project"
           Version="2.4.0.0"
           UpgradeCode="E8F1A2B3-C4D5-6E7F-8A9B-0C1D2E3F4A5B"
           InstallerVersion="500">

    <!-- Application icon (shown in Add/Remove Programs and wizard title bar) -->
    <Icon Id="DirSizeIcon" SourceFile="tray\dirsize.ico" />
    <Property Id="ARPPRODUCTICON" Value="DirSizeIcon" />

    <!-- AllowSameVersionUpgrades: a rebuilt MSI with an unchanged version
         (common during development) replaces the installed copy instead of
         adding a second Apps entry. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage=
        "A newer version of DirSize for Explorer is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Close the tray app (which hosts the scan engine and holds
         DirSizeTray.exe open) before files are installed, replaced, or
         removed — on install, upgrade, AND uninstall. WM_CLOSE first for
         a clean engine shutdown; terminate as a last resort. -->
    <util:CloseApplication Id="CloseTrayApp"
                           Target="DirSizeTray.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           TerminateProcess="1" />

    <!-- Installation directory -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DirSizeForExplorer" />
    </StandardDirectory>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DirSizeMenuFolder" Name="DirSize for Explorer" />
    </StandardDirectory>

    <!-- Features. The tray app is required: it hosts the scan engine
         (which runs in the user's session so mapped network drives and
         the user's share credentials work). The database lives per-user
         under %LocalAppData%, so no shared ProgramData folder is needed. -->
    <Feature Id="Core" Title="DirSize Core" Level="1"
             Description="Shell extension, scan engine, and settings app (required)"
             AllowAbsent="no">
      <ComponentGroupRef Id="CoreComponents" />
      <ComponentGroupRef Id="RegistryComponents" />
      <ComponentGroupRef Id="TrayComponents" />
      <ComponentGroupRef Id="StartMenuComponents" />
    </Feature>

    <!-- Minimal install wizard UI -->
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- License agreement text (required by WixUI_Minimal) -->
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />

    <!-- Custom wizard bitmaps -->
    <WixVariable Id="WixUIDialogBmp" Value="installer\DialogBmp.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="installer\BannerBmp.bmp" />

    <!-- Exit dialog: informational text + launch checkbox -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="DirSize for Explorer has been installed successfully. Directory sizes will appear in the Size column once the background scan completes." />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Launch DirSize Settings" />

    <!-- Launch tray app via ShellExecute when user clicks Finish with checkbox checked -->
    <Property Id="WixShellExecTarget" Value="[#DirSizeTray.exe]" />
    <CustomAction Id="LaunchApplication"
                  DllEntry="WixShellExec"
                  Impersonate="yes"
                  BinaryRef="Wix4UtilCA_X64"
                  Return="ignore" />

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!-- Register the shell extension + property schema after install.
         Note: the old "rundll32 propsys.dll,PSRegisterPropertySchema" call
         never worked — PSRegisterPropertySchema does not have the rundll32
         entry-point signature, so it was called with garbage arguments.
         DllRegisterServer registers the schema (and the COM classes)
         correctly.
         Return="check": a failed registration must FAIL the install (and
         roll back) instead of reporting success while Explorer integration
         silently doesn't work. regsvr32 /s propagates DllRegisterServer's
         HRESULT as a nonzero exit code. -->
    <CustomAction Id="RegisterPropertySchema"
                  Directory="INSTALLFOLDER"
                  ExeCommand="regsvr32.exe /s &quot;[INSTALLFOLDER]DirSizeShellExt.dll&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Unregister on uninstall (also restores any property handler that
         was displaced at install — see DllUnregisterServer). Keep
         Return="ignore": a broken DLL must not make the product
         un-uninstallable. -->
    <CustomAction Id="UnregisterPropertySchema"
                  Directory="INSTALLFOLDER"
                  ExeCommand="regsvr32.exe /u /s &quot;[INSTALLFOLDER]DirSizeShellExt.dll&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Kill Explorer and start it again so the shell extension loads -->
    <CustomAction Id="RestartExplorer"
                  Directory="INSTALLFOLDER"
                  ExeCommand="cmd.exe /c &quot;taskkill /f /im explorer.exe &amp; ping -n 3 127.0.0.1 &gt;nul &amp; start explorer.exe&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- Uninstall: Explorer has the hooked DLL pinned, so it must be
         stopped BEFORE file removal (or the DLL stays locked until
         reboot) and started again once removal is done. Anchored to
         ProgramFiles64Folder because INSTALLFOLDER no longer exists by
         InstallFinalize. Skipped during major upgrades — the new
         version's RestartExplorer handles the restart there. -->
    <CustomAction Id="KillExplorerUninstall"
                  Directory="ProgramFiles64Folder"
                  ExeCommand="taskkill.exe /f /im explorer.exe"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />
    <CustomAction Id="StartExplorerUninstall"
                  Directory="ProgramFiles64Folder"
                  ExeCommand="cmd.exe /c start explorer.exe"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterPropertySchema" After="InstallFiles"
              Condition="NOT Installed" />
      <Custom Action="UnregisterPropertySchema" Before="RemoveFiles"
              Condition="Installed AND REMOVE~=&quot;ALL&quot;" />
      <Custom Action="KillExplorerUninstall" After="UnregisterPropertySchema"
              Condition="Installed AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RestartExplorer" Before="InstallFinalize"
              Condition="NOT Installed" />
      <Custom Action="StartExplorerUninstall" Before="InstallFinalize"
              Condition="Installed AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
